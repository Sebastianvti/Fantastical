local MethodLibrary = {}

function MethodLibrary.Isolate(Sheet, Ability)
	if table.find(Sheet.Active, Ability.Name) then 
	return {Ability.CustomRemove or "Remove"} end
	
	return {Ability.CustomAdd or "Add"}
end

function MethodLibrary.Overwrite(Sheet, Ability)
	if table.find(Sheet.Active, Ability.Name) then
		return {Ability.CustomRemove or "Remove", Ability.CustomAdd or "Add"} 
	end
	
	return {Ability.CustomAdd or "Add"}
end

return MethodLibrary
