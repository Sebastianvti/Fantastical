local Utility = {}

function Utility.Addition(SheetValue : number, Value : number) return SheetValue + Value end
function Utility.Subtract(SheetValue : number, Value : number) return SheetValue - Value end

local function Finalize(Package : any, Sheet : any, Method : string)
	for Key,Value in Package.Stats do
		if not Sheet.Stats[Key] then return end
		local SheetValue = Sheet.Stats[Key]
		
		Sheet.Stats[Key] = Utility[Method](SheetValue, Value)
	end
end

function Utility.Add(Package, Sheet)
	table.insert(Sheet.Active, Package.Name)
	Finalize(Package, Sheet, "Addition")
	print(Sheet)

end

function Utility.AddWithFunction(Package, Sheet)
	table.insert(Sheet.Active, Package.Name)
	Finalize(Package, Sheet, "Addition")
	print(Sheet)

end


function Utility.Remove(Package, Sheet)
	table.remove(Sheet.Active, table.find(Sheet.Active, Package.Name))
	Finalize(Package, Sheet, "Subtract")

	print(Sheet)
	
end

return Utility
